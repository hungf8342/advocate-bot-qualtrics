# Anthropic (default). Copy to .env and set ANTHROPIC_API_KEY.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: only if you switch LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-2024-08-06

# Decision-tree chat model (used by process_chat)
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
