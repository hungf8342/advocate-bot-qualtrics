# Anthropic — complaint extraction (LLM_PROVIDER=anthropic)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: only if you switch LLM_PROVIDER=openai for extraction
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-2024-08-06

# Decision-tree chat router (process_chat) — Z.ai / GLM (default)
CHAT_PROVIDER=zai
ZAI_API_KEY=
ZAI_CHAT_MODEL=glm-5.2
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# Previous Haiku router (disabled; restore chat_structured.py anthropic path to use)
# CHAT_PROVIDER=anthropic
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
